# (Opcional) Google Gemini API Key para síntesis de guiones y papers con IA generativa
# Si se deja vacío, el sistema utiliza el motor clínico heurístico local.
GEMINI_API_KEY=

# (Opcional) Dirección secreta en formato iCal (.ics) de Google Calendar
# Obtener en: Google Calendar -> Configuración de mi calendario -> Integrar el calendario -> Dirección secreta en formato iCal
GOOGLE_CALENDAR_ICS_URL=
